aiss:WalkaroundEvent rdf:type owl:Class;
                     rdfs:subClassOf aiss:Event;
                     rdfs:subClassOf [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:RampAgent
                              ];
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:Aircraft;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:FOD;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:takesPlaceAt ;
