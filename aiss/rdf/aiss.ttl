                        owl:someValuesFrom aiss:MainLandingGearBlockEvent
                  ];
                  rdfs:comment "When ice is removed from the wings of an aircraft with the de-icer vehicle.".


aiss:ToiletServiceEvent rdf:type owl:Class;
