                              owl:onProperty aiss:prerequires ;
                              owl:someValuesFrom aiss:StandClearingAtDepartureEvent
                        ];
                     rdfs:comment "When the ramp agent walks around the aircraft checking for open doors, damage, or debris on the ground.".


aiss:MainLandingGearUnlockEvent rdf:type owl:Class;
      rdfs:subClassOf aiss:Event;
      rdfs:subClassOf [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:involves ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass aiss:Aircraft;
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:involves ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [
                  a owl:Restriction ;
                  owl:onProperty aiss:hasRoleInOrganization ;
                  owl:hasValue aiss:GroundCrewAgent
            ];
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:takesPlaceAt ;
            owl:someValuesFrom aiss:Stand
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:prerequires ;
            owl:someValuesFrom aiss:WalkaroundEvent
      ];
      rdfs:comment "When chocks are removed from the main landing gear.".

aiss:NoseGearUnlockEvent rdf:type owl:Class;
            rdfs:subClassOf aiss:Event;
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass [
                        a owl:Restriction ;
                        owl:onProperty aiss:hasRoleInOrganization ;
                        owl:hasValue aiss:GroundCrewAgent
                  ];
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass aiss:Aircraft;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass [
                        a owl:Restriction ;
                        owl:onProperty aiss:hasRoleInOrganization ;
                        owl:hasValue aiss:FlightCrewAgent
                  ];
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:takesPlaceAt ;
                  owl:someValuesFrom aiss:Stand
            ],
            # I tacchi vengono rimossi PRIMA dal carrello posteriore POI da quello anteriore
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:prerequires ;
                  owl:someValuesFrom aiss:MainLandingGearUnlockEvent
            ];
            rdfs:comment "When chocks are removed from the nose gear, and the pilot can request a READY signal from the AirportOperator.".

aiss:ReadySignalRequestEvent rdf:type owl:Class;
            rdfs:subClassOf aiss:Event;
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass aiss:Aircraft;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass [
                        a owl:Restriction ;
                        owl:onProperty aiss:hasRoleInOrganization ;
                        owl:hasValue aiss:FlightCrewAgent
                  ];
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:takesPlaceAt ;
                  owl:someValuesFrom aiss:Stand
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:prerequires ;
                  owl:someValuesFrom aiss:NoseGearUnlockEvent
            ];
            rdfs:comment "When a READY signal for an aicraft is requested from the AirportOperator.".

aiss:ReadySignalGrantedEvent rdf:type owl:Class;
            rdfs:subClassOf aiss:Event;
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass aiss:Aircraft;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass [
                        a owl:Restriction ;
                        owl:onProperty aiss:hasRoleInOrganization ;
                        owl:hasValue aiss:FlightCrewAgent
                  ];
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:takesPlaceAt ;
                  owl:someValuesFrom aiss:Stand
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:prerequires ;
                  owl:someValuesFrom aiss:ReadySignalRequestEvent
            ];
            rdfs:comment "When a READY signal for the departure of an aircraft is granted by the AirportOperator.".








aiss:EngineStartEvent rdf:type owl:Class;
                      rdfs:subClassOf aiss:Event;
                      rdfs:subClassOf [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:takesPlaceAt ;
                              owl:someValuesFrom aiss:Stand
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:Aircraft;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:ASU;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:FlightCrewAgent
                              ];
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:RampAgent
                              ]; 
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:ControlTowerOperator
                              ];
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:prerequires ;
                              owl:someValuesFrom aiss:NoseGearUnlockEvent
                        ];
                      rdfs:comment "When the aircraft's engines are started up, either internally or with help of an Air Starter Unit (ASU).".

aiss:StandExitEvent rdf:type owl:Class;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Stand
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:ControlTowerOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:EngineStartEvent
                                    ];
                    rdfs:comment "When an aircraft exits the stand, (for instance: in preparation for takeoff). This is ATD (Actual Time of Departure); a.k.a. AOBT (Actuall Off Block Time). This is the end of the turnaround phase.".


aiss:PushbackStandExitEvent rdf:type owl:Class;
                    rdfs:subClassOf aiss:StandExitEvent;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:PushbackTractor;
                                    ];
                    rdfs:comment "When an aircraft is pushed back out of the stand and towed by a tractor.".

aiss:SelfManeuveringStandExitEvent rdf:type owl:Class;
                        rdfs:subClassOf aiss:StandExitEvent;
                        rdfs:comment "When an aircraft exits the stand without relying on external pushback. The aircraft may do it by forward movement or, less commonly, by powerback.".


aiss:TaxiingAtDepartureEvent rdf:type owl:Class;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Taxiway
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:ControlTowerOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:FollowMeOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:StandExitEvent
                                    ];
                    rdfs:comment "When an aircraft moves towards a runway, in preparation for takeoff.".

aiss:TakeoffEvent   rdf:type owl:Class;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Runway
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:ControlTowerOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:TaxiingAtDepartureEvent
                                    ];
                    rdfs:comment "When an aircraft takes off the ground.".


aiss:AirborneOutboundEvent rdf:type owl:Class ;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:AirRoute
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:TakeoffEvent
                                    ];
                    rdfs:comment "When an airborne aircraft finally starts for its destination.".


aiss:GSEIdlingEvent rdf:type owl:Class;
                  rdfs:subClassOf aiss:Event;
                  rdfs:subClassOf [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:takesPlaceAt ;
                        owl:someValuesFrom [
                              rdf:type owl:Class ;
                              owl:unionOf ( aiss:ESA aiss:EPA ) 
                        ]
                  ],
                  [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:involves ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass aiss:GSE;
                  ];
                  rdfs:comment "When a GSE (Ground Support Equipment) vehicle is waiting at an ESA (Equipment Service Area) or an EPA (Equipment Parking Area).".

aiss:ApronCleaningEvent  rdf:type owl:Class;
                         rdfs:subClassOf aiss:Event;
                         rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:RunwayCleaningTruck;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:FOD;
                                    ],
                               [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:takesPlaceAt ;
                                    owl:someValuesFrom aiss:Apron
                               ];
                         rdfs:comment "When the apron is cleaned from FOD.".

aiss:DebrisOnStandEvent  rdf:type owl:Class;
                         rdfs:subClassOf aiss:Event;
                         rdfs:subClassOf 
                               [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:involves ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass aiss:FOD;
                              ],
                              [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:takesPlaceAt ;
                                    owl:someValuesFrom aiss:Stand
                              ];
                         rdfs:comment "When there is FOD on the Apron.".


# PHYSICAL OBJECTS ------------------------------------------------------------------------------------------------------------------------------------------------------------------

aiss:FOD rdf:type owl:Class ;
         rdfs:subClassOf aiss:PhysicalObject;
         rdfs:comment "Foreign Debris Object, any dangerous alien object found on the tarmac.".

aiss:GSE rdf:type owl:Class;
         rdfs:subClassOf ioe:System;
         rdfs:subClassOf aiss:PhysicalObject;
         rdfs:comment "Ground Support Equipment (GSE), any devices or vehicles that serve an aircraft while it's on the tarmac.".

aiss:GPU rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Ground Power Unit (GPU), supplies energy to parked aircraft while engines are off.".

aiss:ACU rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Air Conditioning Unit (ACU), supplies cool/hot air to parked aircraft. Needs GPU.".

aiss:ASU rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Air Starter Unit (ASU), starts up the engine of aircraft models that cannot do it internally.".

aiss:DeicingStand rdf:type owl:Class; 
                  rdfs:subClassOf aiss:Stand;
                  rdfs:comment "A kind of stand that supports de-icing (removing ice from wings).".

aiss:RunwayCleaningTruck rdf:type owl:Class;
                         rdfs:subClassOf aiss:GSE;
                         rdfs:comment "Cleaning service truck.".

aiss:SmartObject rdf:type owl:Class;
           rdfs:subClassOf ioe:SmartObject ;
           rdfs:subClassOf aiss:Agent ;
           rdfs:subClassOf aiss:PhysicalObject;
           rdfs:comment "An IoT device with sensors and actuators.".

aiss:AVDGS rdf:type owl:Class ;
           rdfs:subClassOf aiss:SmartObject;
           rdfs:comment "Advanced Visual Docking Guidance System, helps the aircraft park into a stand, can substitute a human marshaller.".

aiss:PushbackTractor rdf:type owl:Class ;
           rdfs:subClassOf aiss:GSE ;
           rdfs:comment "A kind of vehicle that pushes and tows the aircraft to move it out of the stand.".

aiss:PIGS rdf:type owl:Class;
         rdfs:subClassOf ioe:System;
         rdfs:subClassOf aiss:PhysicalObject;
         rdfs:comment "Passenger Integrated Guidance Systems, they help passengers know where to go.".

aiss:JetBridge rdf:type owl:Class;
         rdfs:subClassOf ioe:System;
         rdfs:subClassOf aiss:PhysicalObject;
         rdfs:comment "A sky bridge that connects a gate to an aircraft.".

aiss:StairTruck rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "A truck that carries stairs to help passengers get onto the aircraft.".

aiss:Bus rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "A shuttle bus used to get passengers from the gate to the aircraft.".

aiss:Ambulift rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "A vehicle that helps PRMs get onto the aircraft.".

aiss:Deicer rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Special vehicle used to remove ice from an aircraft's wings.".

aiss:ToiletServiceTruck rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Removes waste water from the aircraft.".

aiss:AirportCrashTender rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "An airport firetruck.".

aiss:PotableWaterTanker rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Supplies fresh drinking water to the aircraft.".

aiss:CateringTruck rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Vehicle that supplies food to the aircraft.".

aiss:FuelTruck rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Vehicle that supplies fuel to the aircraft.".

aiss:BaggageTruck rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Carries baggage to and from an aircraft.".

aiss:CargoLoader rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Loads baggage to and from an aircraft.".

aiss:BeltLoader rdf:type owl:Class;
         rdfs:subClassOf aiss:GSE;
         rdfs:comment "Conveys baggage between cargo loader and baggae truck.".

aiss:Mass rdf:type owl:Class;
          rdfs:subClassOf xsd:double ;
          rdfs:comment "Mass in kilograms.".

aiss:Deadload rdf:type owl:Class;
           rdfs:subClassOf aiss:PhysicalObject;
           rdfs:comment "Any load transported by an aircraft, such as luggage, mail or goods/cargo.".

aiss:Passenger rdf:type owl:Class;
         rdfs:subClassOf aiss:PhysicalObject;
         rdfs:comment "A person who travels on an aircraft and is not a member of the cabin crew.".

aiss:PRM rdf:type owl:Class;
         rdfs:subClassOf aiss:Passenger;
         rdfs:comment "A Passenger/Person with Reduced Mobility.".

# ROLES ------------------------------------------------------------------------------------------

aiss:FuelSafetySupervisor rdf:type owl:Class;
                        rdf:type owl:NamedIndividual ;
                        rdfs:comment "Agent (usually the pilot) who is responsible for monitoring the refuelling process and constantly communicating with the refuelling team.".

aiss:ControlTowerOperator rdf:type owl:Class;
         rdf:type owl:NamedIndividual ;
         a aiss:Role;
         rdfs:comment "A control tower operator.".

aiss:FollowMeOperator rdf:type owl:Class;
         rdf:type owl:NamedIndividual ;
         a aiss:Role;
         rdfs:comment "The follow me service is offered by a car that helps a landed aircraft reach their parking stand (or viceversa: a departing aircraft in reaching the runway).".

aiss:RampAgent rdf:type owl:Class;
         rdf:type owl:NamedIndividual ;
         a aiss:Role;
         rdfs:comment "A member of the ground crew responsible for the aircraft during its stay in the stand.".

aiss:Marshaller rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Helps the aircraft park in the stand (usually coincides with ramp agent).".

aiss:GuidePerson rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Ensures the no touch policy is enforced when a GSE approaches an aircraft.".

aiss:PassengerHandlerOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Supervises the passengers as they board or leave the aircraft.".

aiss:AccessibilityOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Helps PRMs (Passengers with Reduced Mobility).".

aiss:DeicingOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Operates a de-icer.".

aiss:CleaningHandlerOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Person that cleans the aircraft.".

aiss:RescueAndFirefightingOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "A firefighting service.".

aiss:CargoOperator rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Operates machinery to load/unload cargo from aircraft.".

aiss:CabinCrewAgent rdf:type owl:Class;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Works on board of an aircraft, includes hostesses and stewards.".

aiss:FlightCrewAgent rdf:type owl:Class;
         rdf:type owl:NamedIndividual ;
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "The pilots of an aircraft.".

aiss:CateringOperator rdf:type owl:Class;
         rdf:type owl:NamedIndividual; 
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Person that supplies food to the aircraft.".

aiss:GroundCrewAgent 
         a aiss:Role;
         rdf:type owl:NamedIndividual ;
         rdfs:comment "Worker involved in ground operations on the apron.".

# SITES (LOCATIONS) ------------------------------------------------------------------------------------------------------------------------------------------------------------

aiss:Airport rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:subClassOf [
                        rdf:type owl:Restriction ;
                        owl:onProperty bot:containsZone ;
                        owl:someValuesFrom aiss:Apron
                  ],
                  [
                        rdf:type owl:Restriction ;
                        owl:onProperty bot:containsZone ;
                        owl:someValuesFrom aiss:Runway
                  ],
                  [
                        rdf:type owl:Restriction ;
                        owl:onProperty bot:containsZone ;
                        owl:someValuesFrom aiss:Taxiway
                  ],
                  [
                        rdf:type owl:Restriction ;
                        owl:onProperty bot:containsZone ;
                        owl:someValuesFrom aiss:Gate
                  ];
         rdfs:comment "An airport together with its essential set of premises.".

aiss:Runway rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:comment "A road where an aircraft can land or take off from.".

aiss:Taxiway rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:comment "A road that an aircraft uses to get from the stand to the runway (when departing), and viceversa (when arriving).".

aiss:ApronTaxiway rdf:type owl:Class;
         rdfs:subClassOf aiss:Taxiway;
         rdfs:comment "A taxiway that is within the area of the apron.".

aiss:Apron rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "The place (ajdacent to the terminal buildings) where the aircrafts are parked, loaded/unloaded and maintained while on the ground.";
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty bot:containsZone ;
                  owl:someValuesFrom aiss:Stand
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty bot:containsZone ;
                  owl:someValuesFrom aiss:FuelSafetyZone
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty bot:containsZone ;
                  owl:someValuesFrom aiss:ApronTaxiway
            ].

aiss:FuelSafetyZone rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:comment "A special zone where it is safe to refuel the aircraft.".

aiss:EPA rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "Equipment Parking Area, part of the stand where the GSE can be stationed.".

aiss:NPA rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "No Parking Area, an area where neither aircraft nor GSE can park.".

aiss:ESA rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "Equipment Service Area, area where GSEs wait for their turn to become operational.".

aiss:ERA rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "Equipment Restricted Area, a.k.a Aircraft Safety Area (ASA), area that GSEs have limited access to.".

aiss:Gate rdf:type owl:Class ;
           rdfs:subClassOf aiss:Site;
           rdfs:comment "A gate at the terminal from which passengers board the aircraft.".

aiss:Stand rdf:type owl:Class ;
      rdfs:subClassOf aiss:Site;
      rdfs:subClassOf [
            rdf:type owl:Restriction ;
            owl:onProperty bot:containsZone ;
            owl:someValuesFrom aiss:EPA
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty bot:containsZone ;
            owl:someValuesFrom aiss:ESA
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty bot:containsZone ;
            owl:someValuesFrom aiss:ERA
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty bot:adjacentZone ;
            owl:someValuesFrom aiss:Gate
      ];
      rdfs:comment "The location on the tarmac where a single aircraft is parked during turnaround.".

aiss:HoldingPatternAirspace rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:comment "An airspace above the airport where an aircraft is permitted to wait for its turn before landing".

aiss:AirRoute rdf:type owl:Class;
         rdfs:subClassOf aiss:Site;
         rdfs:comment "The route that an Aicraft follows when on course towards another airport.".

# ORGANIZATIONS --------------------------------------------------------------------------------

aiss:Airline rdf:type owl:Class;
             rdfs:subClassOf aiss:Organization;
             rdfs:comment "A company that organizes flights.".

aiss:AirportOperator rdf:type owl:Class;
             rdfs:subClassOf aiss:Organization;
             rdfs:comment "Organization that manages most of the premises of an airport.".

aiss:Handler rdf:type owl:Class;
             rdfs:subClassOf aiss:Organization;
             rdfs:comment "A contractor that provides some service on the airport premises.".

aiss:Backoffice rdf:type owl:Class;
             rdfs:subClassOf aiss:Organization;
             rdfs:comment "Part of the airport manager that manages resources allocation and planning.".
                  
aiss:Frontoffice rdf:type owl:Class;
             rdfs:subClassOf aiss:Organization;
             rdfs:comment "Part of the airport manages ground crew operations.".

aiss:ControlTower rdf:type owl:Class;
         rdfs:subClassOf aiss:Organization;
         rdfs:comment "A control tower.".

aiss:CateringHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides catering service.".

aiss:PushbackHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides push-back service.".

aiss:FuelHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides re-fuelling service.".

aiss:CleaningHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides cleaning services.".

aiss:LoadUnloadHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides loading and unloading services for cargo and other deadload.".

aiss:PassengerHandler rdf:type owl:Class;
                     rdfs:subClassOf aiss:Handler;
                     rdfs:comment "Provides passenger supervision and routing services.".


