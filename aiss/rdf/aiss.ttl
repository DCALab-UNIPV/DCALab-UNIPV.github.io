                      rdfs:comment "When a Passenger with Reduced Mobility (PRM) uses an Ambulift vehicle to embark or disembark.".


aiss:PRMEmbarkEvent rdf:type owl:Class; 
                    rdfs:subClassOf aiss:PRMTransferEvent;
