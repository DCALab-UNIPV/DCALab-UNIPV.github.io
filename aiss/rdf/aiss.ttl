aiss:DeicingEvent rdf:type owl:Class; 
                  rdfs:subClassOf aiss:Event;
                  rdfs:subClassOf aiss:GSEApproachEvent;
                  rdfs:subClassOf  [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:involves ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass aiss:Aircraft;
                  ],
                  [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:involves ;
                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                        owl:onClass [
                                    a owl:Restriction ;
