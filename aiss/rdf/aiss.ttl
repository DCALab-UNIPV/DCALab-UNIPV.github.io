@prefix aiss: <https://w3id.org/aiss#> .
@prefix bot:  <https://w3id.org/bot#> .
@prefix ioe:  <https://w3id.org/semioe#> .
@prefix org:  <https://www.w3.org/ns/org#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .


<https://w3id.org/aiss#> rdf:type owl:Ontology ;
owl:imports org: ;
<http://purl.org/dc/elements/1.1/created> "2025/07/20 18:44:00" ;
<http://purl.org/dc/elements/1.1/title> "AISS" ;
dcterms:creator [ 
                  rdf:type foaf:Agent ;
                  foaf:homepage <https://orcid.org/0000-0003-2120-2341> ;
                  foaf:name "Antonino Nocera"
            ],
            [ 
                  rdf:type foaf:Agent ;
                  foaf:homepage <https://orcid.org/0000-0002-3371-307X> ;
                  foaf:name "Marco Arazzi"
            ],
            [ 
                  rdf:type foaf:Agent ;
                  foaf:homepage <https://orcid.org/0009-0001-7040-4292> ;
                  foaf:name "Aiman Al Masoud"
            ];
# TODO: add license?
# dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
vann:preferredNamespacePrefix "aiss" ;
vann:preferredNamespaceUri <https://w3id.org/aiss#> ;
rdfs:comment "AISS (Airport Information Semantic Scheme) is an ontology for the airport domain, focused on modelling ground operations, resources, and sources of information, with the aim of optimizing the aircraft turnaround process. Aircraft turnaround is a critical step in airport operations, as it is the process by which the actors across several airports co-ordinate by sharing real-time information." ;
rdfs:label "AISS (Airport Information Semantic Scheme)" ;
owl:versionInfo "0.2" .

# CORE OF THE ONTOLOGY -------------------------------------------------------------------------------------

aiss:startsAt rdf:type owl:ObjectProperty ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Relates an event or process to its actual starting time." ;
              rdfs:label "startsAt" .

aiss:endsAt rdf:type owl:ObjectProperty ;
            rdfs:range xsd:dateTime;
            rdfs:comment "Relates an event or process to its actual ending time." ;
            rdfs:label "endsAt" .

aiss:takesPlaceAt rdf:type owl:ObjectProperty ;
                  rdf:type owl:FunctionalProperty ;
                  rdfs:domain aiss:Event ;
                  rdfs:range aiss:Site ;
                  rdfs:comment "Relates an event to the site (location) it takes place in." ;
                  rdfs:label "takesPlaceAt" .

aiss:prerequires rdf:type owl:ObjectProperty ;
                 rdfs:domain aiss:Event ;
                 rdfs:range aiss:Event;
                 rdfs:comment "Relates an event E to an event E' that is a temporal prerequisite for E." ;
                 rdfs:label "prerequires" .

aiss:blockedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain aiss:Event ;
                 rdfs:range aiss:Event;
                 rdfs:comment "Relates an event E to an event E' that acts as a blocker for E." ;
                 rdfs:label "blockedBy" .

aiss:detectedBy rdf:type owl:ObjectProperty ;
                rdfs:domain aiss:Event ;
                rdfs:range aiss:Agent;
                rdfs:comment "Relates an event to the agent that detected it." ;
                rdfs:label "detectedBy" .

aiss:hasOrigin  rdf:type owl:ObjectProperty;
                rdf:type owl:FunctionalProperty;
                rdfs:domain aiss:Flight ;
                rdfs:range aiss:Airport ;
                rdfs:comment "Relates a flight to its origin airport." ;
                rdfs:label "hasOrigin" .

aiss:hasAircraft rdf:type owl:ObjectProperty ;
                rdfs:domain aiss:Flight ;
                rdfs:range aiss:Aircraft ;
                rdfs:label "hasAircraft".

aiss:hasPassenger rdf:type owl:ObjectProperty ;
                rdfs:domain aiss:Flight ;
                rdfs:range aiss:Passenger ;
                rdfs:label "hasPassenger" .

aiss:hasDeadload rdf:type owl:ObjectProperty ;
                  rdfs:range aiss:Deadload ;
                  rdfs:domain aiss:Flight ;
                  rdfs:label "hasDeadload" .

aiss:hasDestination rdf:type owl:ObjectProperty;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain aiss:Flight ;
                rdfs:range aiss:Airport ;
                rdfs:comment "Relates a flight to its destination airport." ;
                rdfs:label "hasDestination" .

aiss:hasMass rdf:type owl:ObjectProperty;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain aiss:Deadload ;
            rdfs:range aiss:Mass ;
            rdfs:comment "Relates a deadload item to its mass in kilograms." ;
            rdfs:label "hasMass" .

aiss:Site rdf:type owl:Class;
          rdfs:subClassOf ioe:Site;
          rdfs:comment "A physical location.".

aiss:Agent rdf:type owl:Class;
           rdfs:subClassOf ioe:Agent;
           rdfs:comment "A physical or non-physical object endowed with agency.".

aiss:Organization rdf:type owl:Class;
                  rdfs:subClassOf aiss:Agent;
                  rdfs:subClassOf org:Organization;
                  rdfs:comment "An organization involved in the airport ecosystem.".
 
aiss:PhysicalObject rdf:type owl:Class;
                    # Can take part in ioe:Activity
                    rdfs:subClassOf ioe:Agent;
                    # Is located in one place at any given time
                    rdfs:subClassOf [
                        rdf:type owl:Restriction ;
                        owl:onProperty ioe:locatedIn ;
                        owl:cardinality "1"^^xsd:int ;
                  ];
                  rdfs:comment "Any living or non-living physical object, always located in one place/site at any given time.".  

aiss:Aircraft rdf:type owl:Class;
      rdfs:subClassOf ioe:System;
      rdfs:subClassOf aiss:PhysicalObject;
      rdfs:comment "An aircraft such as a jetliner.".

aiss:Flight rdf:type owl:Class;
            rdfs:subClassOf ioe:Process;
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:hasDestination ;
                  owl:cardinality "1"^^xsd:int ;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:hasOrigin ;
                  owl:cardinality "1"^^xsd:int ;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:hasDeadload ;
                  owl:minCardinality "1"^^xsd:int ;
            ],
            [
                  rdf:type owl:Restriction;
                  owl:onProperty aiss:hasAircraft ;
                  owl:cardinality "1"^^xsd:int ;
            ],
            [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:hasPassenger ;
                  owl:minCardinality "1"^^xsd:int ;
            ],
            [ 
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:startsAt;
                  owl:cardinality "1"^^xsd:nonNegativeInteger
            ],
            [ 
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:endsAt;
                  owl:cardinality "1"^^xsd:nonNegativeInteger
            ];
            rdfs:comment "A scheduled commercial flight.".

aiss:HumanAgent rdf:type owl:Class;
            rdfs:subClassOf aiss:Agent;
            rdfs:subClassOf ioe:HAgent;
            rdfs:subClassOf aiss:PhysicalObject;
            rdfs:comment "A person, a human being.".

aiss:involves rdf:type owl:ObjectProperty;
      rdfs:domain aiss:Event;
      rdfs:range aiss:PhysicalObject;
      owl:inverseOf ioe:engagedIn;
      rdfs:comment "Relates an event to a physical object that plays some role in it." .

aiss:Event rdf:type owl:Class ;
           rdfs:subClassOf ioe:Activity;
           rdfs:subClassOf [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:takesPlaceAt;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                           ],
                           # Actual starting time of the event
                           [ 
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:startsAt;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                           ],
                           # Actual ending time of the event
                           [ 
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:endsAt;
                              owl:cardinality "1"^^xsd:nonNegativeInteger
                           ];
           rdfs:comment "Any event that takes place somewhere, involves someone/something, and can be detected by an agent.";
           rdfs:label "Event".

aiss:hasStatus rdf:type owl:ObjectProperty;
      rdf:type owl:FunctionalProperty;
      rdfs:domain aiss:Event;
      rdfs:range aiss:EventStatus;
      rdfs:comment "Relates an event to its status." .

aiss:EventStatus rdf:type owl:Class;
                 rdfs:comment "Termination status of an event.".

aiss:Blocked rdf:type owl:NamedIndividual ,
                    aiss:EventStatus ;
                    rdfs:comment "Event cannot start.".

aiss:Ready rdf:type owl:NamedIndividual ,
                    aiss:EventStatus ;
                    rdfs:comment "Event is ready to start".

aiss:Running rdf:type owl:NamedIndividual ,
                     aiss:EventStatus ;
                     rdfs:comment "Event is running.".

aiss:Completed rdf:type owl:NamedIndividual ,
                        aiss:EventStatus ;
                        rdfs:comment "Event terminated successfully".

aiss:Aborted rdf:type owl:NamedIndividual ,
                     aiss:EventStatus ;
                     rdfs:comment "Event terminated unsuccessfully.".

aiss:Membership rdf:type owl:Class;
                rdfs:subClassOf org:Membership;
                rdfs:comment "A membership of an agent, in an organization, with a role.".

aiss:sufficientlyInformedBy a owl:ObjectProperty ;
    rdfs:domain aiss:Membership;
    rdfs:range  aiss:InfoSource;
    rdfs:comment "Relates a membership to an information source that sufficiently informs it.".

aiss:Role rdf:type owl:Class;
          rdfs:subClassOf org:Role;
          rdfs:comment "A role of an agent in an organization.".

aiss:hasMember a owl:ObjectProperty, rdf:Property, owl:FunctionalProperty;
    rdfs:subPropertyOf org:member;
    rdfs:domain aiss:Membership;
    rdfs:range  aiss:Agent;
    rdfs:comment "Relates a membership to the member agent.".

aiss:isMemberOf a owl:ObjectProperty ;
    owl:inverseOf aiss:hasMember;
    rdfs:comment "Relates member agent to membership.".

aiss:hasOrganization a owl:ObjectProperty, rdf:Property, owl:FunctionalProperty;
    rdfs:subPropertyOf org:organization;
    rdfs:domain aiss:Membership;
    rdfs:range  aiss:Organization;
    rdfs:comment "Relates a membership to the organization it refers to.".

aiss:hasRole a owl:ObjectProperty, rdf:Property;
    rdfs:subPropertyOf org:role;
    rdfs:domain aiss:Membership;
    rdfs:range  aiss:Role;
    rdfs:comment "Relates a membership to the role the member agent plays.".

aiss:hasRoleInOrganization a owl:ObjectProperty ;
    rdfs:domain aiss:Agent ;
    rdfs:range aiss:Role;
    rdfs:comment "Derived property that relates agent directly to its role (without membership mediation).".

# Property chain: Agent -> Membership -> Role
aiss:hasRoleInOrganization
    owl:propertyChainAxiom ( aiss:isMemberOf aiss:hasRole ) .

aiss:Right rdf:type owl:Class;
           rdfs:subClassOf ioe:Right;
           rdfs:comment "A right to do something with some resource.".

aiss:RightOnInfoSource rdf:type owl:Class;
                       rdfs:subClassOf aiss:Right;
                       rdfs:comment "The right to read an info source".

aiss:onInfoSource a owl:ObjectProperty, rdf:Property;
    rdfs:domain aiss:RightOnInfoSource;
    rdfs:range  aiss:InfoSource;
    rdfs:comment "Relates a right to the info source it grants access to.".

aiss:about a owl:ObjectProperty, rdf:Property;
    rdfs:domain aiss:InfoSource;
    rdfs:range  aiss:PhysicalObject;
    rdfs:comment "Relates an info source to the physical object it is about.".

aiss:InfoSource rdf:type owl:Class;
                rdfs:comment "A queryiable information source, such as an API endpoint.".

# EVENTS ----------------------------------------------------------------------------------------------------------------------------------------------------------

aiss:LandingQueueEvent rdf:type owl:Class ;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:HoldingPatternAirspace
                                    ] ;
                    rdfs:comment "When the aircraft is waiting for its turn to land on a runway.".

aiss:TouchdownEvent rdf:type owl:Class ;
                    rdfs:subClassOf aiss:Event;
                    rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:ControlTowerOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Runway
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:LandingQueueEvent
                                    ];
                    rdfs:comment "When the aircraft successfully touches down on the runway, happens at Actual Landing Time (ALDT), corresponding to ATA (Actual Time of Arrival).".

aiss:TaxiingAtArrivalEvent rdf:type owl:Class ;
                           rdfs:subClassOf aiss:Event;
                           rdfs:subClassOf [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass aiss:Aircraft;
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:ControlTowerOperator
                                          ];
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass [
                                                      a owl:Restriction ;
                                                      owl:onProperty aiss:hasRoleInOrganization ;
                                                      owl:hasValue aiss:FollowMeOperator
                                                ];
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:takesPlaceAt ;
                                                owl:someValuesFrom aiss:Taxiway
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:prerequires ;
                                                owl:someValuesFrom aiss:TouchdownEvent
                                          ];
                           rdfs:comment "When the aircraft taxis to reach its parking spot after having landed.".


aiss:StandClearingAtArrivalEvent rdf:type owl:Class;
                        rdfs:subClassOf aiss:Event;
                        rdfs:subClassOf  [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:takesPlaceAt ;
                              owl:someValuesFrom aiss:Stand
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:GroundCrewAgent
                              ];
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:GSE;
                        ];
                       rdfs:comment "When the stand is cleared in preparation for Aircraft Arrival.".


aiss:CheckParkingEvent rdf:type owl:Class ;
                       rdfs:subClassOf aiss:Event;
                       rdfs:subClassOf    [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:RampAgent
                                          ];
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                owl:onClass aiss:FOD;
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:takesPlaceAt ;
                                                owl:someValuesFrom aiss:Stand
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:prerequires ;
                                                owl:someValuesFrom aiss:StandClearingAtArrivalEvent
                                          ];
                       rdfs:comment "When the ramp agent checks the stand for FOD (Foreign Object Debris), prior to aircraft parking.".

# Does this also have to involve a Ramp Agent, or can pilot park without help?
aiss:AircraftParkingEvent rdf:type owl:Class ;
                          rdfs:subClassOf aiss:Event;
                          rdfs:subClassOf  [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass aiss:Aircraft;
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:involves ;
                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                owl:onClass [
                                                      a owl:Restriction ;
                                                      owl:onProperty aiss:hasRoleInOrganization ;
                                                      owl:hasValue aiss:FlightCrewAgent
                                                ];
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:prerequires ;
                                                owl:someValuesFrom aiss:CheckParkingEvent
                                          ],
                                          [
                                                rdf:type owl:Restriction ;
                                                owl:onProperty aiss:takesPlaceAt ;
                                                owl:someValuesFrom aiss:Stand
                                          ];
                         rdfs:comment "When an aircraft is parked into a stand".

aiss:AVDGSAircraftParkingEvent rdf:type owl:Class ;
            rdfs:subClassOf aiss:AircraftParkingEvent;
            rdfs:subClassOf [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass aiss:AVDGS;
            ];
            rdfs:comment "When an AVDGS helps the aircraft park into a stand.".


aiss:MarshallerAircraftParkingEvent rdf:type owl:Class ;
            rdfs:subClassOf aiss:AircraftParkingEvent;
            rdfs:subClassOf  [
                  rdf:type owl:Restriction ;
                  owl:onProperty aiss:involves ;
                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                  owl:onClass [
                        a owl:Restriction ;
                        owl:onProperty aiss:hasRoleInOrganization ;
                        owl:hasValue aiss:Marshaller
                  ];
            ];
            rdfs:comment "When the marshaller (usually = ramp agent) helps the aircraft park into a stand.".


aiss:LandingGearBlockEvent rdf:type owl:Class;
                  rdfs:subClassOf aiss:Event;
                  rdfs:subClassOf  [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:Aircraft;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:prerequires ;
                              owl:someValuesFrom aiss:AircraftParkingEvent
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:takesPlaceAt ;
                              owl:someValuesFrom aiss:Stand
                        ];
            rdfs:comment "When chocks are placed on any landing gear of an aircraft.".


aiss:NoseGearBlockEvent rdf:type owl:Class;
                        rdfs:subClassOf aiss:LandingGearBlockEvent;
                        rdfs:subClassOf [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:GroundCrewAgent
                              ];
                        ];
                        rdfs:comment "When chocks are placed on the aircraft's nose gear.". 

aiss:MainLandingGearBlockEvent rdf:type owl:Class;
      rdfs:subClassOf aiss:LandingGearBlockEvent;
      rdfs:subClassOf [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:prerequires ;
            owl:someValuesFrom aiss:NoseGearBlockEvent
      ],
      [
            rdf:type owl:Restriction ;
            owl:onProperty aiss:involves ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass [
                  a owl:Restriction ;
                  owl:onProperty aiss:hasRoleInOrganization ;
                  owl:hasValue aiss:GroundCrewAgent
            ];
      ];
      rdfs:comment "When chocks are placed on the main landing gear of the aircraft. Happens at: Actual Time of Arrival (ATA); a.k.a Actual In-Block Time (AIBT).".

aiss:AirConditioningEvent rdf:type owl:Class;
              rdfs:subClassOf aiss:GSEApproachEvent;
              rdfs:subClassOf [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:involves ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass aiss:ACU;
                              ],
                              [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:involves ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass aiss:GPU;
                              ],
                              [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:involves ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass aiss:Aircraft;
                              ],
                              [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:takesPlaceAt ;
                                    owl:someValuesFrom aiss:Stand
                              ],
                              [
                                    rdf:type owl:Restriction ;
                                    owl:onProperty aiss:prerequires ;
                                    owl:someValuesFrom aiss:MainLandingGearBlockEvent
                              ];
              rdfs:comment "Time during which Air Conditioning Unit (ACU) remains hooked up to aircraft, for passenger/crew comfort during turnaround.".

aiss:GSEApproachEvent rdf:type owl:Class; 
                      rdfs:subClassOf aiss:Event;
                      rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Stand
                                      ],
                                      [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                      ],
                                      [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:GSE;
                                      ],
                                      [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:GuidePerson
                                          ];
                                      ],
                                      [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:MainLandingGearBlockEvent
                                      ];
                      rdfs:comment "When a GSE (Ground Support Equipment) approaches the aircraft, and a guide person enforces no touch policy.".
                      
aiss:PassengerTransferEvent rdf:type owl:Class; 
                            rdfs:subClassOf aiss:GSEApproachEvent;
                            rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:takesPlaceAt ;
                                          owl:someValuesFrom aiss:Stand
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:Aircraft;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:someValuesFrom aiss:Passenger
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:PassengerHandlerOperator
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:PIGS;
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass [
                                                a owl:Restriction ;
                                                owl:onProperty aiss:hasRoleInOrganization ;
                                                owl:hasValue aiss:RampAgent
                                          ];
                                    ],
                                    [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:prerequires ;
                                          owl:someValuesFrom aiss:MainLandingGearBlockEvent
                                    ];
                            rdfs:comment "When passengers embark or disembark from an aircraft.".

aiss:JetBridgePassengerTransferEvent rdf:type owl:Class; 
                                     rdfs:subClassOf aiss:PassengerTransferEvent;
                                     rdfs:subClassOf [
                                          rdf:type owl:Restriction ;
                                          owl:onProperty aiss:involves ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass aiss:JetBridge;
                                    ];
                                    rdfs:comment "When passengers use a jet-bridge.".

aiss:StairsPassengerTransferEvent rdf:type owl:Class; 
                                  rdfs:subClassOf aiss:PassengerTransferEvent;
                                  rdfs:subClassOf [
                                        rdf:type owl:Restriction ;
                                        owl:onProperty aiss:involves ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass aiss:StairTruck;
