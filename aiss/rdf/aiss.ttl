                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass [
                                    a owl:Restriction ;
                                    owl:onProperty aiss:hasRoleInOrganization ;
                                    owl:hasValue aiss:RampAgent
                              ];
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:involves ;
                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onClass aiss:GSE;
                        ],
                        [
                              rdf:type owl:Restriction ;
                              owl:onProperty aiss:prerequires ;
                              owl:someValuesFrom aiss:MainLandingGearBlockEvent
                        ];
