                                  [
                                        rdf:type owl:Restriction ;
                                        owl:onProperty aiss:involves ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass aiss:Bus;
                                  ];
                                  rdfs:comment "When passengers use a shuttle bus and stairs.".

aiss:JetBridgePassengerDisembarkEvent rdf:type owl:Class;
                                    rdfs:subClassOf aiss:JetBridgePassengerTransferEvent;
                                    rdfs:comment "When passengers use a jet-bridge to disembark.".

aiss:StairsPassengerDisembarkEvent rdf:type owl:Class;
                                    rdfs:subClassOf aiss:StairsPassengerTransferEvent;
                                    rdfs:comment "When passengers use stairs and shuttle bus to disembark.".

# May require disembarkment (but not if airplane is already empty)
aiss:JetBridgePassengerEmbarkEvent rdf:type owl:Class;
                                    rdfs:subClassOf aiss:JetBridgePassengerTransferEvent;
                                    rdfs:comment "When passengers use a jet-bridge to embark.".

aiss:StairsPassengerEmbarkEvent  rdf:type owl:Class;
                                 rdfs:subClassOf aiss:StairsPassengerTransferEvent;
                                 rdfs:comment "When passengers use stairs and shuttle bus to embark.".

aiss:PRMTransferEvent rdf:type owl:Class; 
