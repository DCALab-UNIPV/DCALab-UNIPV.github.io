                    [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:involves ;
                        owl:someValuesFrom aiss:Aircraft
                    ]
                    ;
                    rdfs:comment "When a significant amount of fuel (e.g. >= 3 meters in diameter) spills down on the stand.".

aiss:FireEvent rdf:type owl:Class; 
                  rdfs:subClassOf aiss:Event;
                  rdfs:subClassOf  [
                        rdf:type owl:Restriction ;
                        owl:onProperty aiss:prerequires;
                        owl:someValuesFrom aiss:FuelSpillEvent
                  ],
