  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aiss#StandExitEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/aiss#Event"/>
    <rdfs:subClassOf rdf:nodeID="nfaaae256caf543f38dc592d5ab36ef34b188"/>
