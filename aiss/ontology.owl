    <rdfs:subClassOf rdf:resource="https://w3id.org/aiss#Organization"/>
    <rdfs:comment>Organization that manages most of the premises of an airport.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aiss#QuickCleaningEvent">
