    <rdfs:subClassOf rdf:nodeID="nfaaae256caf543f38dc592d5ab36ef34b60"/>
    <rdfs:comment>Time during which Air Conditioning Unit (ACU) remains hooked up to aircraft, for passenger/crew comfort during turnaround.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aiss#Marshaller">
