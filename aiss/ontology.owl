    <rdfs:subClassOf rdf:nodeID="nfaaae256caf543f38dc592d5ab36ef34b190"/>
    <rdfs:subClassOf rdf:nodeID="nfaaae256caf543f38dc592d5ab36ef34b192"/>
    <rdfs:comment>When an aircraft exits the stand, (for instance: in preparation for takeoff). This is ATD (Actual Time of Departure); a.k.a. AOBT (Actuall Off Block Time). This is the end of the turnaround phase.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/aiss#PushbackTractor">
